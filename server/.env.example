# Server Environment Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/wedding_wishcraft?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Security & Rate Limiting
JWT_SECRET=your_jwt_secret_key_here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Direct UPI QR Payment (Fallback)
UPI_ID=your_upi_id_here
UPI_PAYEE_NAME=Your_Payee_Name

# SMS OTP Service (Fast2SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key

# ==========================================
# RAZORPAY PAYMENT GATEWAY CONFIGURATION
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
