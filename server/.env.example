# Server Environment Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/wedding_wishcraft?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Security & Rate Limiting
JWT_SECRET=your_jwt_secret_key_here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Direct UPI QR Payment (Fallback)
UPI_ID=your_upi_id_here
UPI_PAYEE_NAME=Your_Payee_Name

# SMS OTP Service (Fast2SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key

# ==========================================
# CASHFREE PAYMENT GATEWAY CONFIGURATION
# ==========================================
# CASHFREE_ENV: TEST (Sandbox) or PRODUCTION
CASHFREE_ENV=TEST
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_API_VERSION=2023-08-01
